# TESSERA multi-city settings. Keep secrets in this local file; do not commit it.
SOURCE_MODE=india
TZ=Asia/Kolkata

# Optional live Delhi Open Transit Data API key. Leave blank to use clearly marked simulated GPS.
OTD_API_KEY=
OTD_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb

# Mobility Database catalog API: paste your long-lived refresh token here later.
# The application exchanges it for short-lived access tokens automatically.
MOBILITY_DATABASE_REFRESH_TOKEN=
MOBILITY_DATABASE_API_BASE=https://api.mobilitydatabase.org/v1

# Mobility Database feed IDs for schedule routes/stops.
MDB_CHENNAI_FEED_ID=mdb-3360
MDB_HYDERABAD_FEED_ID=mdb-3361
MDB_HUBLI_DHARWAD_FEED_ID=mdb-3141

# Synthetic bus GPS is used for demo-only live positions when no city-specific GTFS-RT feed exists.
# This is deliberately labeled SIMULATED in the dashboard.
NUM_CITY_SYNTHETIC_VEHICLES=90
BMTC_LIVE=1
